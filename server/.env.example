PORT=5000
# MongoDB connection string: Local or MongoDB Atlas (free tier M0 cluster)
# If left empty in development, Lernen will automatically spin up an in-memory MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/lernen
JWT_SECRET=lernen_development_secret_key_change_in_production_2026
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# SMTP / Email Settings (e.g. Gmail with 16-character App Password)
# For Gmail: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="DeutschHub" <your_email@gmail.com>
